files:
  "/etc/nginx/conf.d/proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      upstream nodejs {
          server 127.0.0.1:8080;
          keepalive 256;
      }
      
      server {
          listen 80;
          
          access_log /var/log/nginx/access.log main;
          error_log /var/log/nginx/error.log;
          
          # Health check endpoint
          location /health {
              proxy_pass http://nodejs/health;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
              proxy_connect_timeout 5s;
              proxy_read_timeout 10s;
          }
          
          # Static files
          location /images/ {
              alias /var/app/current/images/;
              expires 1y;
              add_header Cache-Control "public, immutable";
          }
          
          # All other requests
          location / {
              proxy_pass http://nodejs;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
              proxy_connect_timeout 10s;
              proxy_read_timeout 30s;
          }
      }

container_commands:
  01_remove_default_nginx:
    command: "rm -f /etc/nginx/conf.d/default.conf"
    ignoreErrors: true
  02_backup_main_nginx:
    command: "cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.backup"
    ignoreErrors: true
  03_remove_default_server:
    command: "sed -i '/server {/,/}/d' /etc/nginx/nginx.conf"
    ignoreErrors: true
  04_reload_nginx:
    command: "nginx -t && service nginx reload"
    ignoreErrors: true